    state.aliens = state.aliens.filter(a => !(a.zone === 'left' && !a.isBoss));
    state.aliens.push(new Alien(state.dividerX - 100, state.groundY - 84, 'rickprime', 'left'));
    state.announcements.push({ text: 'РИК ПРАЙМ АТАКУЕТ!', life: 120, color: '#ff2222' });
    state.screenShake = 25;
  }
  if (type === 'evilmorty' && !state.evilMortySpawned) {
    state.evilMortySpawned = true;
    state.aliens = state.aliens.filter(a => !(a.zone === 'right' && !a.isBoss));
    state.aliens.push(new Alien(DESIGN_W - 80, state.groundY - 70, 'evilmorty', 'right'));
    state.announcements.push({ text: 'ЗЛОЙ МОРТИ АТАКУЕТ!', life: 120, color: '#ff8800' });
    state.screenShake = 25;
