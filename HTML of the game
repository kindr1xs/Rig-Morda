}
function damageAlien(a, dmg, fromX) {
  a.health -= dmg; a.hitFlash = 12;
  if (a.health <= 0) {
    const idx = state.aliens.indexOf(a);
    if (idx >= 0) state.aliens.splice(idx, 1);
    state.score++;
    if (a.isBoss) {
      state.announcements.push({ text: 'БОСС ПОВЕРЖЕН!', life: 100, color: '#ffff00' });
      state.screenShake = 20;
