      if (a.x + a.width > state.dividerX - 4) a.x = state.dividerX - 4 - a.width;
    } else {
      if (a.x < state.dividerX + 4) a.x = state.dividerX + 4;
      if (a.x + a.width > DESIGN_W) a.x = DESIGN_W - a.width;
    }
  }
  return false;
}

function fireMelee(p) {
  p.meleeActive = true; p.meleeTimer = 15; p.meleeCooldown = p.meleeCooldownMax;
  const range = 55;
  const hitBox = { x: p.facing > 0 ? p.x + p.width : p.x - range, y: p.y + 10, w: range, h: p.height - 10 };
  const dmg = p.type === 'rick' ? 45 : 35;
  for (let i = state.aliens.length - 1; i >= 0; i--) {
    const a = state.aliens[i];
    if (a.zone !== p.zone) continue;
    if (rectsIntersect(hitBox, { x: a.x, y: a.y, w: a.width, h: a.height })) {
      damageAlien(a, dmg, p.x + p.width/2);
    }
  }
