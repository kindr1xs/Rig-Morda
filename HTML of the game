<!DOCTYPE html>
<html lang="ru">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, viewport-fit=cover">
<meta name="apple-mobile-web-app-capable" content="yes">
<title>Rick & Morty: Two Planets</title>
<style>
  * { margin:0; padding:0; box-sizing:border-box; user-select:none; -webkit-user-select:none; touch-action:manipulation; -webkit-tap-highlight-color:transparent; }
  html, body { width:100%; height:100%; overflow:hidden; background:#050510; font-family:'Courier New', monospace; }
  body { display:flex; justify-content:center; align-items:center; }
  #game-container { position:relative; width:100vw; height:100vh; max-width:100%; max-height:100%; background:#0a0a1a; overflow:hidden; }
  canvas { display:block; width:100%; height:100%; image-rendering:pixelated; image-rendering:crisp-edges; touch-action:none; }
  #ui { position:absolute; inset:0; pointer-events:none; display:flex; flex-direction:column; justify-content:space-between; padding:8px; }
  #top-bar { display:flex; justify-content:space-between; align-items:flex-start; width:100%; gap:8px; }
  .player-hud { flex:1; max-width:38%; }
  .player-hud.right { text-align:right; }
  .player-name { font-size:12px; font-weight:bold; color:#fff; text-shadow:2px 2px 0 #000; margin-bottom:4px; letter-spacing:1px; }
  .player-hud.p1 .player-name { color:#66ccff; }
  .player-hud.p2 .player-name { color:#ffdd33; }
  .player-hud.dead .player-name { color:#888 !important; }
  .hp-bar { background:#333; border:2px solid #000; height:14px; border-radius:3px; overflow:hidden; box-shadow:0 0 0 1px #fff3; }
  .hp-bar.right { direction:rtl; }
  .hp-fill { height:100%; background:#00ff00; transition:width 0.15s; width:100%; }
  .hp-fill.low { background:#ff4444; }
  #score { color:#ff0; font-size:15px; font-weight:bold; text-shadow:2px 2px 0 #000; background:rgba(0,0,0,0.75); padding:6px 12px; border-radius:5px; border:2px solid #ff0; white-space:nowrap; align-self:center; }
  #controls { display:flex; justify-content:space-between; align-items:flex-end; width:100%; pointer-events:none; padding-bottom:6px; gap:6px; }
  .player-controls { display:flex; align-items:flex-end; gap:6px; pointer-events:none; }
  .joystick-zone { width:78px; height:78px; pointer-events:auto; position:relative; }
  .buttons-grid { display:grid; grid-template-columns:1fr 1fr; gap:4px; pointer-events:auto; }
  .action-btn { width:36px; height:36px; border-radius:50%; background:rgba(255,255,255,0.12); border:2px solid #fff; color:#fff; font-size:9px; font-weight:bold; font-family:'Courier New', monospace; display:flex; justify-content:center; align-items:center; text-shadow:1px 1px 0 #000; box-shadow:0 3px 0 rgba(0,0,0,0.6); touch-action:manipulation; cursor:pointer; transition:opacity 0.15s; position:relative; overflow:hidden; }
  .action-btn:active { transform:translateY(3px); box-shadow:0 0 0 rgba(0,0,0,0.6); }
  .action-btn.cooldown { opacity:0.35; filter:grayscale(0.8); }
  .action-btn.cooldown::after { content:attr(data-cd); position:absolute; inset:0; background:rgba(0,0,0,0.6); display:flex; align-items:center; justify-content:center; font-size:11px; color:#fff; }
  .p1-jump { background:rgba(0,150,255,0.3); border-color:#33aaff; }
  .p1-fire { background:rgba(51,255,51,0.25); border-color:#33ff33; }
  .p1-melee { background:rgba(255,140,0,0.3); border-color:#ff8800; }
  .p1-portal { background:rgba(0,255,200,0.3); border-color:#00ffcc; }
  .p2-jump { background:rgba(255,200,0,0.3); border-color:#ffcc00; }
  .p2-fire { background:rgba(255,150,50,0.3); border-color:#ff9933; }
  .p2-melee { background:rgba(255,80,180,0.3); border-color:#ff44aa; }
  .p2-portal { background:rgba(180,100,255,0.3); border-color:#aa66ff; }
  .player-controls.dead .joystick-zone, .player-controls.dead .buttons-grid { opacity:0; pointer-events:none; }
  .revive-overlay { position:absolute; bottom:30%; transform:translateX(-50%); z-index:20; pointer-events:auto; display:none; }
  .revive-overlay.p1 { left:25%; }
  .revive-overlay.p2 { left:75%; }
  .revive-overlay.active { display:block; }
  .revive-btn { padding:18px 28px; font-size:15px; font-weight:bold; font-family:'Courier New', monospace; color:#fff; border:3px solid #fff; border-radius:14px; background:linear-gradient(135deg, #ff3377, #aa0055); box-shadow:0 6px 0 rgba(0,0,0,0.5), 0 0 30px rgba(255,51,119,0.6); cursor:pointer; text-shadow:2px 2px 0 #000; animation:pulseRevive 1s ease-in-out infinite; white-space:nowrap; }
  .revive-btn.countdown { background:linear-gradient(135deg, #555, #333); animation:none; box-shadow:0 6px 0 rgba(0,0,0,0.5); cursor:not-allowed; }
  .revive-btn:active:not(.countdown) { transform:translateY(6px); box-shadow:0 0 0 rgba(0,0,0,0.5); }
  @keyframes pulseRevive { 0%, 100% { transform:scale(1); } 50% { transform:scale(1.06); } }
  .overlay { position:absolute; inset:0; display:flex; flex-direction:column; justify-content:center; align-items:center; padding:20px; z-index:50; pointer-events:auto; text-align:center; }
  #lobby { background:radial-gradient(circle at 30% 30%, rgba(60,20,100,0.95), rgba(5,5,20,0.98)); }
  #lobby h1 { font-size:clamp(28px, 7vw, 56px); color:#66ff99; text-shadow:4px 4px 0 #003322, 0 0 30px #00ff88; margin-bottom:6px; letter-spacing:3px; }
  #lobby h2 { font-size:clamp(16px, 3vw, 24px); color:#ffcc00; text-shadow:2px 2px 0 #000; margin-bottom:30px; letter-spacing:2px; }
  #lobby .controls-info { background:rgba(0,0,0,0.5); border:2px solid #3388ff; border-radius:12px; padding:16px 20px; margin-bottom:24px; max-width:520px; font-size:clamp(11px, 2vw, 14px); line-height:1.5; color:#fff; }
  #lobby .controls-info .p1-info { color:#66ccff; text-align:left; margin-bottom:8px; }
  #lobby .controls-info .p2-info { color:#ffdd33; text-align:left; margin-bottom:8px; }
  #lobby .controls-info .warning { color:#ff6666; font-weight:bold; margin-top:10px; text-align:center; }
  .big-btn { padding:20px 60px; font-size:clamp(20px, 4vw, 28px); background:linear-gradient(135deg, #00ff88, #00aa55); border:none; border-radius:16px; color:#000; font-weight:bold; cursor:pointer; box-shadow:0 8px 0 #005522, 0 0 30px rgba(0,255,136,0.5); font-family:'Courier New', monospace; letter-spacing:2px; }
  .big-btn:active { transform:translateY(8px); box-shadow:0 0 0 #005522; }
  #game-over { background:radial-gradient(circle at 50% 40%, rgba(120,0,0,0.95), rgba(5,5,20,0.98)); display:none; }
  #game-over h1 { font-size:clamp(28px, 6vw, 48px); color:#ff3333; text-shadow:4px 4px 0 #000, 0 0 30px #ff0000; margin-bottom:16px; letter-spacing:3px; }
  #game-over .final { font-size:clamp(20px, 3.5vw, 28px); color:#ffcc00; margin-bottom:30px; }
  #game-over .msg { font-size:clamp(13px, 2.5vw, 18px); color:#aaa; margin-bottom:30px; max-width:450px; }
  #lobby-btn { padding:18px 55px; font-size:clamp(18px, 3vw, 24px); background:linear-gradient(135deg, #66ccff, #2266aa); border:none; border-radius:14px; color:#fff; font-weight:bold; cursor:pointer; box-shadow:0 8px 0 #003366; font-family:'Courier New', monospace; letter-spacing:2px; }
  #lobby-btn:active { transform:translateY(8px); box-shadow:0 0 0 #003366; }
  @media (min-width: 500px) {
    #ui { padding:10px; }
    .joystick-zone { width:95px; height:95px; }
    .action-btn { width:45px; height:45px; font-size:11px; }
    .player-name { font-size:14px; }
    .hp-bar { height:16px; }
    #score { font-size:17px; padding:8px 15px; }
    .revive-btn { padding:22px 38px; font-size:18px; }
  }
  @media (min-width: 700px) {
    .joystick-zone { width:115px; height:115px; }
    .action-btn { width:55px; height:55px; font-size:13px; border-width:3px; }
    .buttons-grid { gap:6px; }
    .player-name { font-size:17px; margin-bottom:6px; }
    .hp-bar { height:18px; border-width:3px; }
    #score { font-size:18px; padding:9px 18px; border-width:3px; }
    .revive-btn { padding:26px 50px; font-size:22px; }
  }
  @media (min-width: 1000px) {
    .joystick-zone { width:140px; height:140px; }
    .action-btn { width:68px; height:68px; font-size:15px; }
    .player-name { font-size:20px; }
    .hp-bar { height:22px; }
    #score { font-size:22px; padding:12px 22px; }
    .revive-btn { padding:30px 60px; font-size:26px; }
  }
</style>
</head>
<body>
<div id="game-container">
  <canvas id="gameCanvas"></canvas>
  <div id="ui">
    <div id="top-bar">
      <div class="player-hud p1" id="p1-hud">
        <div class="player-name" id="p1-name">◄ RICK</div>
        <div class="hp-bar"><div class="hp-fill" id="hp1-fill"></div></div>
      </div>
      <div id="score">KILLS: 0</div>
      <div class="player-hud p2 right" id="p2-hud">
        <div class="player-name" id="p2-name">MORTY ►</div>
        <div class="hp-bar right"><div class="hp-fill" id="hp2-fill"></div></div>
      </div>
    </div>
    <div id="controls">
      <div class="player-controls" id="p1-controls">
        <div id="joy1-zone" class="joystick-zone"></div>
        <div class="buttons-grid">
          <button class="action-btn p1-jump" id="jump1">JMP</button>
          <button class="action-btn p1-fire" id="fire1">FIRE</button>
          <button class="action-btn p1-melee" id="melee1">HIT</button>
          <button class="action-btn p1-portal" id="portal1">PORT</button>
        </div>
      </div>
      <div class="player-controls" id="p2-controls">
        <div class="buttons-grid">
          <button class="action-btn p2-jump" id="jump2">JMP</button>
          <button class="action-btn p2-fire" id="fire2">FIRE</button>
          <button class="action-btn p2-melee" id="melee2">HIT</button>
          <button class="action-btn p2-portal" id="portal2">PORT</button>
        </div>
        <div id="joy2-zone" class="joystick-zone"></div>
      </div>
    </div>
  </div>
  <div class="revive-overlay p1" id="revive1-overlay"><button class="revive-btn" id="revive1">ВОЗРОДИТЬ</button></div>
  <div class="revive-overlay p2" id="revive2-overlay"><button class="revive-btn" id="revive2">ВОЗРОДИТЬ</button></div>
  <div class="overlay" id="lobby">
    <h1>RICK & MORTY</h1>
    <h2>ДВЕ ПЛАНЕТЫ</h2>
    <div class="controls-info">
      <div class="p1-info"><b>◄ РИК</b> (слева): джойстик + JMP/FIRE/HIT/PORT</div>
      <div class="p2-info"><b>МОРТИ ►</b> (справа): джойстик + JMP/FIRE/HIT/PORT</div>
      <div class="warning">⚠ Если оба героя погибнут — игра окончена!</div>
      <div class="warning">Возрождение доступно через 5 секунд после смерти</div>
    </div>
    <button class="big-btn" id="play-btn">ИГРАТЬ</button>
  </div>
  <div class="overlay" id="game-over">
    <h1>ИГРА ОКОНЧЕНА</h1>
    <div class="final">Убито врагов: <span id="final-score">0</span></div>
    <div class="msg">Оба героя пали. Мультивселенная захвачена злыми клонами...</div>
    <button id="lobby-btn">В ЛОББИ</button>
  </div>
</div>

<script src="https://cdnjs.cloudflare.com/ajax/libs/nipplejs/0.10.2/nipplejs.min.js"></script>
<script>
(function(){
'use strict';

const canvas = document.getElementById('gameCanvas');
const ctx = canvas.getContext('2d');
const hp1Fill = document.getElementById('hp1-fill');
const hp2Fill = document.getElementById('hp2-fill');
const scoreEl = document.getElementById('score');
const p1Name = document.getElementById('p1-name');
const p2Name = document.getElementById('p2-name');
const p1Hud = document.getElementById('p1-hud');
const p2Hud = document.getElementById('p2-hud');
const revive1Overlay = document.getElementById('revive1-overlay');
const revive2Overlay = document.getElementById('revive2-overlay');
const revive1Btn = document.getElementById('revive1');
const revive2Btn = document.getElementById('revive2');
const lobbyEl = document.getElementById('lobby');
const gameOverEl = document.getElementById('game-over');
const finalScoreEl = document.getElementById('final-score');
const playBtn = document.getElementById('play-btn');
const lobbyBtn = document.getElementById('lobby-btn');

let DESIGN_W = 900, DESIGN_H = 600, viewScale = 1;

const state = {
  gameStatus: 'lobby',
  players: [], aliens: [], projectiles: [], enemyProjectiles: [],
  portalEffects: [], announcements: [], score: 0,
  groundY: 0, gravity: 0.6, dividerX: 0, stars: [],
  spawnTimerLeft: 0, spawnTimerRight: 0, spawnInterval: 110,
  rickPrimeSpawned: false, evilMortySpawned: false,
  screenShake: 0
};

const REVIVE_COOLDOWN_FRAMES = 300;
const PORTAL_COOLDOWN_FRAMES = 720;

const RICK_PALETTES = {
  basic:{ coat:'#f0f0f0', coatShadow:'#d8d8d8', lapel:'#ffffff', shirt:'#5cb8e0', hair:'#33aaff', hairDark:'#2299ee', hairLight:'#66ccff', skin:'#f0c8a0', skinShadow:'#d8b090', pants:'#6b4e1f', shoe:'#2a1a0a', shoeLight:'#4a3a1a', brow:'#5a3a1a', mouth:'#5a1a1a', shotColor:'#66ff66' },
  fast:{ coat:'#f0e0e0', coatShadow:'#d8c0c0', lapel:'#ffffff', shirt:'#cc3333', hair:'#ff5555', hairDark:'#cc2222', hairLight:'#ff8888', skin:'#f0c8a0', skinShadow:'#d8b090', pants:'#4a2a0a', shoe:'#1a0a0a', shoeLight:'#3a2a1a', brow:'#3a1a1a', mouth:'#5a1a1a', shotColor:'#ff5555' },
  ranged:{ coat:'#2a1a3a', coatShadow:'#1a0a2a', lapel:'#4a3a5a', shirt:'#aa66ff', hair:'#8855dd', hairDark:'#6633bb', hairLight:'#aa77ee', skin:'#d8c0a0', skinShadow:'#b8a080', pants:'#1a1a2a', shoe:'#0a0a1a', shoeLight:'#2a2a3a', brow:'#1a0a2a', mouth:'#2a0a1a', shotColor:'#bb55ee' }
};
const MORTY_PALETTES = {
  basic:{ shirt:'#ffdd00', shirtShadow:'#e6c700', collar:'#fff', pants:'#3366cc', shoe:'#777', shoeLight:'#999', hair:'#8B4513', hairDark:'#5a2a0a', skin:'#f0c8a0', skinShadow:'#d8b090', mouth:'#5a1a1a', shotColor:'#ffff44' },
  fast:{ shirt:'#4488ff', shirtShadow:'#2266dd', collar:'#fff', pants:'#222', shoe:'#333', shoeLight:'#555', hair:'#5a2a0a', hairDark:'#3a1a0a', skin:'#f0c8a0', skinShadow:'#d8b090', mouth:'#5a1a1a', shotColor:'#4488ff' },
  ranged:{ shirt:'#9933ff', shirtShadow:'#7722cc', collar:'#fff', pants:'#333', shoe:'#222', shoeLight:'#444', hair:'#1a0f05', hairDark:'#000', skin:'#e8d0b0', skinShadow:'#c8b090', mouth:'#1a0000', shotColor:'#bb55ee' }
};

function resizeCanvas() {
  const rect = document.getElementById('game-container').getBoundingClientRect();
  canvas.width = rect.width; canvas.height = rect.height;
  const minDim = Math.min(canvas.width, canvas.height);
  viewScale = Math.max(0.4, minDim / 550);
  DESIGN_W = canvas.width / viewScale;
  DESIGN_H = canvas.height / viewScale;
  const controlsDesign = 145 / viewScale;
  state.groundY = Math.min(DESIGN_H - controlsDesign - 10, DESIGN_H * 0.88);
  state.dividerX = DESIGN_W / 2;
  if (state.players.length) {
    state.players[0].spawnX = 30;
    state.players[1].spawnX = DESIGN_W - 100;
    for (const p of state.players) {
      p.y = state.groundY - p.height;
      if (p.alive) {
        if (p.zone === 'left') {
          if (p.x + p.width > state.dividerX - 10) p.x = state.dividerX - 10 - p.width;
          if (p.x < 10) p.x = 10;
        } else {
          if (p.x < state.dividerX + 10) p.x = state.dividerX + 10;
          if (p.x + p.width > DESIGN_W - 10) p.x = DESIGN_W - 10 - p.width;
        }
      }
    }
  }
  state.stars = [];
  for (let i = 0; i < 80; i++) {
    state.stars.push({ x: Math.random() * DESIGN_W, y: Math.random() * DESIGN_H * 0.7, size: Math.random() * 2 + 1, speed: Math.random() * 0.4 + 0.1, layer: Math.random() < 0.5 ? 1 : 2 });
  }
}
window.addEventListener('resize', resizeCanvas);
window.addEventListener('orientationchange', () => setTimeout(resizeCanvas, 300));

function createPlayerInput() {
  return { left:false, right:false, joystickX:0, attackHeld:false, jumpPressed:false, meleePressed:false, portalPressed:false };
}

function createRick() {
  return {
    name:'Rick', type:'rick', zone:'left',
    x:30, y:0, width:40, height:60, spawnX:30,
    vx:0, vy:0, speed:4, jumpPower:-13,
    health:100, maxHealth:100, facing:1, onGround:false,
    shootCooldown:0, shootCooldownMax:14,
    meleeCooldown:0, meleeCooldownMax:40, meleeActive:false, meleeTimer:0,
    portalCooldown:0, knockbackVx:0, knockbackTimer:0,
    attacking:false, attackTimer:0,
    invulnerable:false, invulnerableTimer:0,
    walkTimer:0, alive:true, reviveCooldown:0, shotColor:'#66ff66',
    input: createPlayerInput()
  };
}
function createMorty() {
  return {
    name:'Morty', type:'morty', zone:'right',
    x:100, y:0, width:36, height:54, spawnX:100,
    vx:0, vy:0, speed:4.3, jumpPower:-12,
    health:85, maxHealth:85, facing:1, onGround:false,
    shootCooldown:0, shootCooldownMax:16,
    meleeCooldown:0, meleeCooldownMax:45, meleeActive:false, meleeTimer:0,
    portalCooldown:0, knockbackVx:0, knockbackTimer:0,
    attacking:false, attackTimer:0,
    invulnerable:false, invulnerableTimer:0,
    walkTimer:0, alive:true, reviveCooldown:0, shotColor:'#ffff44',
    input: createPlayerInput()
  };
}

let joy1 = null, joy2 = null;
function setupJoysticks() {
  if (typeof nipplejs === 'undefined') return;
  try { if (joy1) joy1.destroy(); if (joy2) joy2.destroy(); } catch(e) {}
  const size = window.innerWidth >= 700 ? 115 : (window.innerWidth >= 500 ? 90 : 78);
  joy1 = nipplejs.create({ zone: document.getElementById('joy1-zone'), mode:'static', position:{ left:'50%', top:'50%' }, color:'#33aaff', size:size, restJoystick:true, restOpacity:0.4 });
  joy1.on('move', (evt, data) => { if (data && data.vector && state.players[0]) state.players[0].input.joystickX = data.vector.x; });
  joy1.on('end', () => { if (state.players[0]) state.players[0].input.joystickX = 0; });
  joy2 = nipplejs.create({ zone: document.getElementById('joy2-zone'), mode:'static', position:{ left:'50%', top:'50%' }, color:'#ffcc00', size:size, restJoystick:true, restOpacity:0.4 });
  joy2.on('move', (evt, data) => { if (data && data.vector && state.players[1]) state.players[1].input.joystickX = data.vector.x; });
  joy2.on('end', () => { if (state.players[1]) state.players[1].input.joystickX = 0; });
}

function bindButton(id, playerIdx, action) {
  const el = document.getElementById(id);
  if (!el) return;
  const clone = el.cloneNode(true);
  el.parentNode.replaceChild(clone, el);
  const press = (e) => {
    e.preventDefault();
    const p = state.players[playerIdx];
    if (!p || !p.alive) return;
    if (action === 'attack') p.input.attackHeld = true;
    else if (action === 'jump') p.input.jumpPressed = true;
    else if (action === 'melee') p.input.meleePressed = true;
    else if (action === 'portal') p.input.portalPressed = true;
  };
  const release = (e) => {
    if (e) e.preventDefault();
    const p = state.players[playerIdx];
    if (!p) return;
    if (action === 'attack') p.input.attackHeld = false;
  };
  clone.addEventListener('pointerdown', press);
  clone.addEventListener('pointerup', release);
  clone.addEventListener('pointercancel', release);
  clone.addEventListener('pointerleave', release);
}

window.addEventListener('keydown', (e) => {
  if (state.gameStatus !== 'playing' || !state.players.length) return;
  const p0 = state.players[0], p1 = state.players[1];
  if (!p0 || !p1) return;
  if (e.key === 'a' || e.key === 'A') p0.input.left = true;
  if (e.key === 'd' || e.key === 'D') p0.input.right = true;
  if (e.key === 'w' || e.key === 'W') p0.input.jumpPressed = true;
  if (e.key === 'f' || e.key === 'F') p0.input.attackHeld = true;
  if (e.key === 'g' || e.key === 'G') p0.input.meleePressed = true;
  if (e.key === 'r' || e.key === 'R') p0.input.portalPressed = true;
  if (e.key === 'ArrowLeft') { p1.input.left = true; e.preventDefault(); }
  if (e.key === 'ArrowRight') { p1.input.right = true; e.preventDefault(); }
  if (e.key === 'ArrowUp') { p1.input.jumpPressed = true; e.preventDefault(); }
  if (e.key === 'Enter') { p1.input.attackHeld = true; e.preventDefault(); }
  if (e.key === 'Shift') { p1.input.meleePressed = true; e.preventDefault(); }
  if (e.key === 'Control') { p1.input.portalPressed = true; e.preventDefault(); }
});
window.addEventListener('keyup', (e) => {
  if (!state.players.length) return;
  const p0 = state.players[0], p1 = state.players[1];
  if (!p0 || !p1) return;
  if (e.key === 'a' || e.key === 'A') p0.input.left = false;
  if (e.key === 'd' || e.key === 'D') p0.input.right = false;
  if (e.key === 'f' || e.key === 'F') p0.input.attackHeld = false;
  if (e.key === 'ArrowLeft') p1.input.left = false;
  if (e.key === 'ArrowRight') p1.input.right = false;
