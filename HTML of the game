// === ПОРТАЛ — БЕЗ УРОНА, ЧИСТЫЙ ТЕЛЕПОРТ ===
function firePortal(p) {
  if (!p || !p.alive) return;

  // Эффект на старой позиции (только визуал)
  const oldCx = p.x + p.width/2;
  const oldCy = p.y + p.height/2;
  state.portalEffects.push({ x: oldCx, y: oldCy, life: 40, maxLife: 40 });

  // Безопасный телепорт на спавн (без урона по врагам)
  placePlayerAtSpawn(p);

  // Полное лечение и неуязвимость
  p.health = p.maxHealth;
  p.invulnerable = true; p.invulnerableTimer = 90;
  p.portalCooldown = PORTAL_COOLDOWN_FRAMES;

  // Эффект на новой позиции
  state.portalEffects.push({ x: p.x + p.width/2, y: p.y + p.height/2, life: 40, maxLife: 40 });
  state.screenShake = 15;
}

function updatePlayer(p) {
  if (!p.alive) return;

  // ⚠️ ЗАЩИТА ОТ NaN — если позиция сломалась, восстанавливаем
  if (isNaN(p.x) || isNaN(p.y)) {
    console.warn('Player position is NaN, recovering...');
    placePlayerAtSpawn(p);
  }
  if (isNaN(p.health)) p.health = p.maxHealth;
  if (isNaN(p.portalCooldown)) p.portalCooldown = 0;

  if (p.invulnerable) { p.invulnerableTimer--; if (p.invulnerableTimer <= 0) p.invulnerable = false; }
  if (p.shootCooldown > 0) p.shootCooldown--;
  if (p.meleeCooldown > 0) p.meleeCooldown--;
  if (p.portalCooldown > 0) p.portalCooldown--;
  if (p.meleeActive) { p.meleeTimer--; if (p.meleeTimer <= 0) p.meleeActive = false; }

  if (p.knockbackTimer > 0) {
    p.knockbackTimer--;
    p.x += p.knockbackVx;
    p.knockbackVx *= 0.88;
    p.vy += state.gravity; p.y += p.vy;
    if (p.y + p.height >= state.groundY) { p.y = state.groundY - p.height; p.vy = 0; p.onGround = true; }
    if (p.zone === 'left') {
      if (p.x < 0) p.x = 0;
      if (p.x + p.width > state.dividerX - 4) p.x = state.dividerX - 4 - p.width;
    } else {
      if (p.x < state.dividerX + 4) p.x = state.dividerX + 4;
      if (p.x + p.width > DESIGN_W) p.x = DESIGN_W - p.width;
    }
    return;
  }

  if (p.input.portalPressed) {
    p.input.portalPressed = false;
    if (p.portalCooldown <= 0) firePortal(p);
  }
  if (p.input.meleePressed) {
    p.input.meleePressed = false;
    if (p.meleeCooldown <= 0 && !p.meleeActive) fireMelee(p);
  }
  if (p.input.jumpPressed) {
    p.input.jumpPressed = false;
    if (p.onGround) { p.vy = p.jumpPower; p.onGround = false; }
  }

  let moveX = 0;
  if (p.input.left) moveX -= 1;
  if (p.input.right) moveX += 1;
  if (Math.abs(p.input.joystickX) > 0.2) moveX = p.input.joystickX;
  if (moveX > 0.2) { p.vx = p.speed; p.facing = 1; }
  else if (moveX < -0.2) { p.vx = -p.speed; p.facing = -1; }
  else p.vx *= 0.65;

  if (p.input.attackHeld && p.shootCooldown <= 0 && !p.meleeActive) {
    p.attacking = true; p.attackTimer = 12; p.shootCooldown = p.shootCooldownMax;
    const gunX = p.facing > 0 ? p.x + p.width - 2 : p.x - 6;
    const gunY = p.y + 28;
    const dmg = p.type === 'rick' ? 15 : 12;
    state.projectiles.push({ x: gunX, y: gunY, vx: p.facing * 11, vy: 0, radius: 7, damage: dmg, life: 90, color: p.shotColor, zone: p.zone });
  }
  if (p.attacking) { p.attackTimer--; if (p.attackTimer <= 0) p.attacking = false; }

  p.vy += state.gravity; p.y += p.vy;
  if (p.y + p.height >= state.groundY) { p.y = state.groundY - p.height; p.vy = 0; p.onGround = true; }
  else p.onGround = false;

  p.x += p.vx;
  if (p.zone === 'left') {
    if (p.x < 0) p.x = 0;
    if (p.x + p.width > state.dividerX - 4) p.x = state.dividerX - 4 - p.width;
  } else {
    if (p.x < state.dividerX + 4) p.x = state.dividerX + 4;
    if (p.x + p.width > DESIGN_W) p.x = DESIGN_W - p.width;
  }
}

function killPlayer(p) {
  if (!p.alive) return;
  p.alive = false; p.health = 0;
  p.reviveCooldown = REVIVE_COOLDOWN_FRAMES;
  state.portalEffects.push({ x: p.x + p.width/2, y: p.y + p.height/2, life: 40, maxLife: 40 });
  p.input.left = false; p.input.right = false;
  p.input.attackHeld = false;
  p.input.jumpPressed = false; p.input.meleePressed = false; p.input.portalPressed = false;
  p.input.joystickX = 0;
  p.attacking = false; p.attackTimer = 0;
  p.meleeActive = false; p.meleeTimer = 0;
  p.knockbackTimer = 0; p.knockbackVx = 0;
}

function tryRevive(idx) {
  const p = state.players[idx];
  if (!p || p.alive) return;
  if (p.reviveCooldown > 0) return;
  if (!state.players[0].alive && !state.players[1].alive) return;
  p.alive = true;
  p.health = p.maxHealth;
  placePlayerAtSpawn(p);
  p.invulnerable = true; p.invulnerableTimer = 90;
  p.reviveCooldown = 0;
  p.input.left = false; p.input.right = false;
  p.input.attackHeld = false;
  p.input.jumpPressed = false; p.input.meleePressed = false; p.input.portalPressed = false;
  p.input.joystickX = 0;
  state.portalEffects.push({ x: p.x + p.width/2, y: p.y + p.height/2, life: 40, maxLife: 40 });
  state.screenShake = 10;
}

function updateGame() {
  if (state.gameStatus !== 'playing') return;
  for (const p of state.players) {
    updatePlayer(p);
    if (!p.alive && p.reviveCooldown > 0) p.reviveCooldown--;
  }

  for (let i = state.projectiles.length - 1; i >= 0; i--) {
    const proj = state.projectiles[i];
    proj.x += proj.vx; proj.y += proj.vy; proj.life--;
    if (proj.life <= 0 || proj.x < -30 || proj.x > DESIGN_W + 30) { state.projectiles.splice(i, 1); continue; }
    for (let j = state.aliens.length - 1; j >= 0; j--) {
      const a = state.aliens[j];
      if (a.zone !== proj.zone) continue;
      if (circleRectIntersect(proj.x, proj.y, proj.radius, a.x, a.y, a.width, a.height)) {
        damageAlien(a, proj.damage);
        state.projectiles.splice(i, 1);
        break;
      }
    }
  }

  for (let i = state.enemyProjectiles.length - 1; i >= 0; i--) {
    const proj = state.enemyProjectiles[i];
    proj.x += proj.vx; proj.y += proj.vy; proj.life--;
    if (proj.life <= 0 || proj.x < -30 || proj.x > DESIGN_W + 30 || proj.y > DESIGN_H + 30) { state.enemyProjectiles.splice(i, 1); continue; }
    let hit = false;
    for (const p of state.players) {
      if (!p.alive || p.invulnerable) continue;
      if (p.zone !== proj.zone) continue;
      if (circleRectIntersect(proj.x, proj.y, proj.radius, p.x, p.y, p.width, p.height)) {
        p.health -= proj.damage; p.invulnerable = true; p.invulnerableTimer = 60;
        if (p.health < 0) p.health = 0;
        hit = true; break;
      }
    }
    if (hit) state.enemyProjectiles.splice(i, 1);
  }

  for (let i = state.aliens.length - 1; i >= 0; i--) {
    const a = state.aliens[i];
    a.update();
    if (a.x < -200 || a.x > DESIGN_W + 200) state.aliens.splice(i, 1);
  }

  const bossLeftActive = state.aliens.some(a => a.isBoss && a.zone === 'left');
  const bossRightActive = state.aliens.some(a => a.isBoss && a.zone === 'right');
  const interval = Math.max(40, state.spawnInterval - state.score * 2);
  state.spawnTimerLeft++; state.spawnTimerRight++;
  const leftAliens = state.aliens.filter(a => a.zone === 'left' && !a.isBoss).length;
  const rightAliens = state.aliens.filter(a => a.zone === 'right' && !a.isBoss).length;
  if (state.spawnTimerLeft >= interval && leftAliens < 5 && !bossLeftActive) { spawnAlien('left'); state.spawnTimerLeft = 0; }
  if (state.spawnTimerRight >= interval && rightAliens < 5 && !bossRightActive) { spawnAlien('right'); state.spawnTimerRight = 0; }

  if (state.score >= 8 && !state.rickPrimeSpawned) spawnBoss('rickprime');
  if (state.score >= 18 && !state.evilMortySpawned) spawnBoss('evilmorty');

  for (let i = state.announcements.length - 1; i >= 0; i--) {
    state.announcements[i].life--;
    if (state.announcements[i].life <= 0) state.announcements.splice(i, 1);
  }
  for (let i = state.portalEffects.length - 1; i >= 0; i--) {
    state.portalEffects[i].life--;
    if (state.portalEffects[i].life <= 0) state.portalEffects.splice(i, 1);
  }
  if (state.screenShake > 0) state.screenShake *= 0.9;

  for (const p of state.players) {
    if (p.health <= 0 && p.alive) killPlayer(p);
  }

  if (!state.players[0].alive && !state.players[1].alive) {
    state.gameStatus = 'gameover';
    gameOverEl.style.display = 'flex';
    finalScoreEl.textContent = state.score;
  }

  updateHUD();
}

function updateHUD() {
  for (let i = 0; i < 2; i++) {
    const p = state.players[i];
    const fill = i === 0 ? hp1Fill : hp2Fill;
    const hud = i === 0 ? p1Hud : p2Hud;
    const nameEl = i === 0 ? p1Name : p2Name;
    const controlsEl = document.getElementById('p' + (i+1) + '-controls');
    const reviveEl = i === 0 ? revive1Overlay : revive2Overlay;
    const reviveBtn = i === 0 ? revive1Btn : revive2Btn;
    const portalBtn = document.getElementById('portal' + (i+1));
    const meleeBtn = document.getElementById('melee' + (i+1));
    if (p.alive) {
      const pct = (p.health / p.maxHealth) * 100;
      fill.style.width = pct + '%';
      fill.className = 'hp-fill' + (pct < 30 ? ' low' : '');
      hud.classList.remove('dead');
      nameEl.textContent = i === 0 ? '◄ RICK · ПЛАНЕТА РИКОВ' : 'ПЛАНЕТА МОРТИ · MORTY ►';
      controlsEl.classList.remove('dead');
      reviveEl.classList.remove('active');
    } else {
      fill.style.width = '0%';
      hud.classList.add('dead');
      nameEl.textContent = i === 0 ? '◄ RICK (ПАЛ)' : '(ПАЛ) MORTY ►';
      controlsEl.classList.add('dead');
      reviveEl.classList.add('active');
      if (p.reviveCooldown > 0) {
        const secs = Math.ceil(p.reviveCooldown / 60);
        reviveBtn.textContent = `ВОЗРОЖДЕНИЕ ${secs}с`;
        reviveBtn.classList.add('countdown');
      } else {
        reviveBtn.textContent = 'ВОЗРОДИТЬ';
        reviveBtn.classList.remove('countdown');
      }
    }
    if (portalBtn) {
      if (p.portalCooldown > 0) {
        portalBtn.classList.add('cooldown');
        portalBtn.setAttribute('data-cd', Math.ceil(p.portalCooldown / 60));
      } else {
        portalBtn.classList.remove('cooldown');
        portalBtn.removeAttribute('data-cd');
      }
    }
    if (meleeBtn) {
      if (p.meleeCooldown > 0) meleeBtn.classList.add('cooldown');
      else meleeBtn.classList.remove('cooldown');
    }
  }
  scoreEl.textContent = 'KILLS: ' + state.score;
}

function drawBackground() {
  const gradL = ctx.createLinearGradient(0, 0, 0, DESIGN_H);
  gradL.addColorStop(0, '#0a0a2a'); gradL.addColorStop(0.6, '#1a1a4a'); gradL.addColorStop(1, '#2a2a5a');
  ctx.fillStyle = gradL; ctx.fillRect(0, 0, state.dividerX, DESIGN_H);
  const gradR = ctx.createLinearGradient(0, 0, 0, DESIGN_H);
  gradR.addColorStop(0, '#2a1a0a'); gradR.addColorStop(0.6, '#4a2a1a'); gradR.addColorStop(1, '#5a3a1a');
  ctx.fillStyle = gradR; ctx.fillRect(state.dividerX, 0, DESIGN_W - state.dividerX, DESIGN_H);
  for (const s of state.stars) {
    s.y += s.speed * 0.2;
    if (s.y > DESIGN_H * 0.7) { s.y = 0; s.x = Math.random() * DESIGN_W; }
    const onLeft = s.x < state.dividerX;
    ctx.fillStyle = onLeft ? (s.layer === 1 ? 'rgba(180,220,255,0.6)' : 'rgba(220,240,255,0.9)') : (s.layer === 1 ? 'rgba(255,220,180,0.6)' : 'rgba(255,240,220,0.9)');
    ctx.fillRect(s.x, s.y, s.size, s.size);
  }
  ctx.fillStyle = 'rgba(150, 200, 255, 0.3)'; ctx.beginPath(); ctx.arc(DESIGN_W * 0.18, DESIGN_H * 0.16, 40, 0, Math.PI*2); ctx.fill();
  ctx.fillStyle = 'rgba(255, 200, 120, 0.3)'; ctx.beginPath(); ctx.arc(DESIGN_W * 0.82, DESIGN_H * 0.16, 45, 0, Math.PI*2); ctx.fill();
  ctx.fillStyle = '#1a2a4a'; ctx.fillRect(0, state.groundY, state.dividerX, DESIGN_H - state.groundY);
  ctx.fillStyle = '#4a6aa0'; ctx.fillRect(0, state.groundY, state.dividerX, 6);
  for (let i = 20; i < state.dividerX - 20; i += 60) {
    ctx.fillStyle = 'rgba(120, 200, 255, 0.35)';
    ctx.beginPath(); ctx.moveTo(i, state.groundY + 20); ctx.lineTo(i + 5, state.groundY + 5); ctx.lineTo(i + 10, state.groundY + 20); ctx.fill();
  }
  ctx.fillStyle = '#2a3a5a';
  for (let i = 0; i < state.dividerX; i += 24) { ctx.fillRect(i + (i % 48), state.groundY + 28, 12, 4); ctx.fillRect(i + 8, state.groundY + 40, 8, 3); }
  ctx.fillStyle = '#4a2a1a'; ctx.fillRect(state.dividerX, state.groundY, DESIGN_W - state.dividerX, DESIGN_H - state.groundY);
  ctx.fillStyle = '#8a5a2a'; ctx.fillRect(state.dividerX, state.groundY, DESIGN_W - state.dividerX, 6);
  for (let i = state.dividerX + 20; i < DESIGN_W - 20; i += 60) {
    ctx.fillStyle = 'rgba(255, 180, 100, 0.35)';
    ctx.fillRect(i, state.groundY + 15, 14, 8); ctx.fillRect(i + 4, state.groundY + 12, 6, 3);
  }
  ctx.fillStyle = '#5a3a1a';
  for (let i = state.dividerX; i < DESIGN_W; i += 24) { ctx.fillRect(i + (i % 48), state.groundY + 28, 12, 4); ctx.fillRect(i + 8, state.groundY + 40, 8, 3); }
  const pulse = 0.5 + Math.sin(Date.now() / 400) * 0.3;
  ctx.strokeStyle = 'rgba(255,255,255,' + pulse + ')'; ctx.lineWidth = 3;
  ctx.beginPath(); ctx.moveTo(state.dividerX, 0); ctx.lineTo(state.dividerX, DESIGN_H); ctx.stroke();
  ctx.strokeStyle = 'rgba(255,0,255,' + (pulse * 0.4) + ')'; ctx.lineWidth = 8;
  ctx.beginPath(); ctx.moveTo(state.dividerX, 0); ctx.lineTo(state.dividerX, DESIGN_H); ctx.stroke();
  ctx.font = 'bold 14px Courier New'; ctx.textAlign = 'center';
  ctx.fillStyle = 'rgba(102,204,255,0.6)'; ctx.fillText('❄ ПЛАНЕТА РИКОВ ❄', state.dividerX / 2, state.groundY + 60);
  ctx.fillStyle = 'rgba(255,180,80,0.6)'; ctx.fillText('☀ ПЛАНЕТА МОРТИ ☀', state.dividerX + (DESIGN_W - state.dividerX) / 2, state.groundY + 60);
  ctx.textAlign = 'left';
}

function drawPortalEffects() {
  for (const fx of state.portalEffects) {
    const t = 1 - fx.life / fx.maxLife;
    const radius = 15 + t * 80;
    ctx.strokeStyle = 'rgba(0, 255, 200,' + (1 - t) + ')';
    ctx.lineWidth = 5;
    ctx.beginPath(); ctx.arc(fx.x, fx.y, radius, 0, Math.PI*2); ctx.stroke();
    ctx.fillStyle = 'rgba(0, 255, 200,' + (0.6 * (1 - t)) + ')';
    ctx.beginPath(); ctx.arc(fx.x, fx.y, radius * 0.7, 0, Math.PI*2); ctx.fill();
    ctx.fillStyle = 'rgba(200, 255, 255,' + (0.9 * (1 - t)) + ')';
    ctx.beginPath(); ctx.arc(fx.x, fx.y, radius * 0.3, 0, Math.PI*2); ctx.fill();
    ctx.strokeStyle = 'rgba(150, 100, 255,' + (0.7 * (1 - t)) + ')';
    ctx.lineWidth = 3;
    ctx.beginPath(); ctx.arc(fx.x, fx.y, radius * 0.9, 0, Math.PI*2); ctx.stroke();
    ctx.strokeStyle = 'rgba(255, 255, 255,' + (0.9 * (1 - t)) + ')';
    ctx.lineWidth = 2;
    ctx.beginPath();
    for (let i = 0; i < 24; i++) {
      const ang = i * 0.4 + t * 8;
      const r = (i / 24) * radius * 0.85;
      const x = fx.x + Math.cos(ang) * r;
      const y = fx.y + Math.sin(ang) * r;
      if (i === 0) ctx.moveTo(x, y); else ctx.lineTo(x, y);
    }
    ctx.stroke();
  }
}

function drawGame() {
  ctx.setTransform(1, 0, 0, 1, 0, 0);
  ctx.fillStyle = '#050510';
  ctx.fillRect(0, 0, canvas.width, canvas.height);
  let shakeX = 0, shakeY = 0;
  if (state.screenShake > 0.5) {
    shakeX = (Math.random() - 0.5) * state.screenShake;
    shakeY = (Math.random() - 0.5) * state.screenShake;
  }
  ctx.setTransform(viewScale, 0, 0, viewScale, shakeX, shakeY);
  drawBackground();
  for (const a of state.aliens) a.draw();
  for (const p of state.players) {
    if (p.type === 'rick') drawRick(p); else drawMorty(p);
  }
  for (const proj of state.projectiles) {
    const hex = proj.color.replace('#', '');
    const r = parseInt(hex.substring(0, 2), 16);
    const g = parseInt(hex.substring(2, 4), 16);
    const b = parseInt(hex.substring(4, 6), 16);
    ctx.fillStyle = 'rgba(' + r + ',' + g + ',' + b + ',0.35)';
    ctx.beginPath(); ctx.arc(proj.x, proj.y, proj.radius * 2.2, 0, Math.PI * 2); ctx.fill();
    ctx.fillStyle = proj.color;
    ctx.beginPath(); ctx.arc(proj.x, proj.y, proj.radius, 0, Math.PI * 2); ctx.fill();
    ctx.fillStyle = '#fff';
    ctx.beginPath(); ctx.arc(proj.x, proj.y, proj.radius * 0.45, 0, Math.PI * 2); ctx.fill();
  }
  for (const proj of state.enemyProjectiles) {
    const hex = proj.color.replace('#', '');
    const r = parseInt(hex.substring(0, 2), 16) || 170;
    const g = parseInt(hex.substring(2, 4), 16) || 68;
    const b = parseInt(hex.substring(4, 6), 16) || 221;
    ctx.fillStyle = 'rgba(' + r + ',' + g + ',' + b + ',0.35)';
    ctx.beginPath(); ctx.arc(proj.x, proj.y, proj.radius * 2, 0, Math.PI * 2); ctx.fill();
    ctx.fillStyle = proj.color;
    ctx.beginPath(); ctx.arc(proj.x, proj.y, proj.radius, 0, Math.PI * 2); ctx.fill();
    ctx.fillStyle = '#fff';
    ctx.beginPath(); ctx.arc(proj.x, proj.y, proj.radius * 0.4, 0, Math.PI * 2); ctx.fill();
  }
  drawPortalEffects();
  for (const ann of state.announcements) {
    const alpha = Math.min(1, ann.life / 40);
    ctx.save();
    ctx.globalAlpha = alpha;
    ctx.font = 'bold 32px Courier New';
    ctx.textAlign = 'center';
    ctx.textBaseline = 'middle';
    ctx.strokeStyle = '#000'; ctx.lineWidth = 8;
    ctx.strokeText(ann.text, DESIGN_W / 2, DESIGN_H * 0.3);
    ctx.fillStyle = ann.color;
    ctx.fillText(ann.text, DESIGN_W / 2, DESIGN_H * 0.3);
    ctx.restore();
  }
}

// Обёртка с try/catch чтобы ошибки не ломали игру
function gameLoop() {
  try {
    updateGame();
    drawGame();
  } catch(e) {
    console.error('Game loop error:', e);
  }
  requestAnimationFrame(gameLoop);
}

function resetGame() {
  state.players = [createRick(), createMorty()];
  state.players[0].spawnX = 30;
  state.players[1].spawnX = DESIGN_W - 100;
  state.players[0].x = 30;
  state.players[1].x = DESIGN_W - 100;
  for (const p of state.players) {
    p.y = state.groundY - p.height;
    if (isNaN(p.x)) p.x = 30;
    if (isNaN(p.y)) p.y = state.groundY - p.height;
  }
  state.aliens = []; state.projectiles = []; state.enemyProjectiles = [];
  state.portalEffects = []; state.announcements = [];
  state.score = 0;
  state.spawnTimerLeft = 0; state.spawnTimerRight = 0;
  state.rickPrimeSpawned = false; state.evilMortySpawned = false;
  state.screenShake = 0;
  hp1Fill.style.width = '100%'; hp2Fill.style.width = '100%';
  hp1Fill.className = 'hp-fill'; hp2Fill.className = 'hp-fill';
  scoreEl.textContent = 'KILLS: 0';
  bindButton('jump1', 0, 'jump');
  bindButton('fire1', 0, 'attack');
  bindButton('melee1', 0, 'melee');
  bindButton('portal1', 0, 'portal');
  bindButton('jump2', 1, 'jump');
  bindButton('fire2', 1, 'attack');
  bindButton('melee2', 1, 'melee');
  bindButton('portal2', 1, 'portal');
  revive1Overlay.classList.remove('active');
  revive2Overlay.classList.remove('active');
  updateHUD();
}

function startGame() {
  resetGame();
  state.gameStatus = 'playing';
  lobbyEl.style.display = 'none';
  gameOverEl.style.display = 'none';
}
function returnToLobby() {
  state.gameStatus = 'lobby';
  gameOverEl.style.display = 'none';
  lobbyEl.style.display = 'flex';
  state.aliens = []; state.projectiles = []; state.enemyProjectiles = [];
  state.portalEffects = []; state.announcements = [];
  for (const p of state.players) { p.alive = false; p.health = 0; }
  updateHUD();
}

playBtn.addEventListener('click', startGame);
playBtn.addEventListener('touchstart', (e) => { e.preventDefault(); startGame(); }, { passive:false });
lobbyBtn.addEventListener('click', returnToLobby);
lobbyBtn.addEventListener('touchstart', (e) => { e.preventDefault(); returnToLobby(); }, { passive:false });
revive1Btn.addEventListener('click', () => tryRevive(0));
revive1Btn.addEventListener('pointerdown', (e) => { e.preventDefault(); tryRevive(0); });
revive2Btn.addEventListener('click', () => tryRevive(1));
revive2Btn.addEventListener('pointerdown', (e) => { e.preventDefault(); tryRevive(1); });

resizeCanvas();
state.players = [createRick(), createMorty()];
state.players[0].spawnX = 30;
state.players[1].spawnX = DESIGN_W - 100;
for (const p of state.players) p.y = state.groundY - p.height;
setupJoysticks();
requestAnimationFrame(gameLoop);

document.addEventListener('touchmove', (e) => {
  if (e.target.closest('.joystick-zone') || e.target.closest('.action-btn') || e.target.closest('.revive-btn') || e.target.closest('.big-btn') || e.target.closest('#lobby-btn')) e.preventDefault();
}, { passive: false });

})();
</script>
